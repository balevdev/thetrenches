---
import StoryCardBackFace from './StoryCardBackFace.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  formattedDate: string;
  isoDate: string;
  readTime: string;
  tags: string[];
  heroImage?: string;
}

const { title, description, href, formattedDate, isoDate, readTime, tags, heroImage } = Astro.props;
---

<article class="story-card reveal">
  <a href={href} class="story-card__flipper">
    {/* ── Front face ── */}
    <div class="story-card__front">
      <div class="story-card__image">
        {heroImage ? (
          <img src={heroImage} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="story-card__placeholder">
            <div class="story-card__placeholder-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </div>
          </div>
        )}
        <span class="story-card__badge">Story</span>
      </div>
      <div class="story-card__content">
        <div class="story-card__meta">
          <span class="story-card__category">Story</span>
          <span class="story-card__separator">&middot;</span>
          <time class="story-card__date" datetime={isoDate}>{formattedDate}</time>
        </div>
        <h3 class="story-card__title" set:html={title} />
        <p class="story-card__description">{description}</p>
        <div class="story-card__footer">
          <span class="story-card__read-time">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readTime}
          </span>
          {tags.length > 0 && (
            <div class="story-card__tags">
              {tags.slice(0, 2).map(tag => (
                <span class="badge">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    {/* ── Back face ── */}
    <div class="story-card__back">
      <StoryCardBackFace title={title} />
    </div>
  </a>
</article>

<style>
  /* ══════════════════════════════════════════════
     Story card — base appearance
     ══════════════════════════════════════════════ */
  .story-card {
    background-color: var(--bg-card);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-smooth);
    background-image: linear-gradient(
      160deg,
      var(--bg-card) 60%,
      rgba(251, 191, 36, 0.04) 100%
    );
  }

  .story-card:hover {
    transform: translateY(-4px);
    border-color: rgba(251, 191, 36, 0.5);
    box-shadow:
      0 8px 32px rgba(251, 191, 36, 0.12),
      0 0 0 1px rgba(251, 191, 36, 0.1);
  }

  /* ── Link / flipper ── */
  .story-card__flipper {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* ── Image area ── */
  .story-card__image {
    aspect-ratio: 16 / 9;
    background-color: var(--bg-secondary);
    overflow: hidden;
    position: relative;
  }

  .story-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth), opacity var(--transition-fast);
  }

  .story-card:hover .story-card__image img {
    transform: scale(1.05);
  }

  .story-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      rgba(251, 191, 36, 0.15) 0%,
      var(--bg-tertiary) 40%,
      rgba(251, 147, 60, 0.10) 70%,
      rgba(251, 191, 36, 0.08) 100%
    );
    position: relative;
  }

  .story-card__placeholder-icon {
    color: #fbbf24;
    opacity: 0.6;
    transition: all var(--transition-smooth);
  }

  .story-card:hover .story-card__placeholder-icon {
    transform: scale(1.1);
    opacity: 0.7;
  }

  .story-card__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1714;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  /* ── Content area ── */
  .story-card__content {
    padding: var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .story-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .story-card__category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: #fbbf24;
  }

  .story-card__separator {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .story-card__date {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .story-card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .story-card:hover .story-card__title {
    color: #fbbf24;
  }

  .story-card__title :global(em) {
    font-style: italic;
    color: #fbbf24;
  }

  .story-card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin: 0 0 var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .story-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(251, 191, 36, 0.1);
  }

  .story-card__read-time {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .story-card__read-time svg {
    opacity: 0.7;
  }

  .story-card__tags {
    display: flex;
    gap: var(--space-2);
  }

  .story-card__tags .badge {
    font-size: 0.65rem;
  }

  /* ── Back face wrapper (hidden by default) ── */
  .story-card__back {
    display: none;
  }

  /* ══════════════════════════════════════════════
     3D flip mechanism — hover-capable, large screens
     ══════════════════════════════════════════════ */
  @media (hover: hover) and (min-width: 769px) {
    .story-card {
      perspective: 1000px;
      overflow: visible;
      background: transparent;
      border: none;
      background-image: none;
    }

    .story-card:hover {
      transform: none;
      box-shadow: none;
      border-color: transparent;
    }

    .story-card__flipper {
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .story-card:hover .story-card__flipper {
      transform: rotateY(180deg);
    }

    /* Both faces */
    .story-card__front,
    .story-card__back {
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--radius-xl);
      overflow: hidden;
    }

    /* Front face — in normal flow (defines card height) */
    .story-card__front {
      background-color: var(--bg-card);
      border: 1px solid rgba(251, 191, 36, 0.25);
      background-image: linear-gradient(
        160deg,
        var(--bg-card) 60%,
        rgba(251, 191, 36, 0.04) 100%
      );
    }

    :global([data-theme="light"]) .story-card__front {
      border-color: rgba(217, 119, 6, 0.2);
    }

    /* Back face — absolutely positioned, pre-rotated */
    .story-card__back {
      display: block;
      position: absolute;
      inset: 0;
      transform: rotateY(180deg);
    }

    /* Disable front face hover effects during flip */
    .story-card:hover .story-card__title {
      color: var(--text-primary);
    }

    .story-card:hover .story-card__image img {
      transform: none;
    }

    .story-card:hover .story-card__placeholder-icon {
      transform: none;
      opacity: 0.6;
    }
  }

  /* ══════════════════════════════════════════════
     Reduced motion — disable flip, restore glow hover
     ══════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .story-card {
      perspective: none;
      overflow: hidden;
      background-color: var(--bg-card);
      border: 1px solid rgba(251, 191, 36, 0.25);
      background-image: linear-gradient(
        160deg,
        var(--bg-card) 60%,
        rgba(251, 191, 36, 0.04) 100%
      );
    }

    .story-card:hover {
      transform: translateY(-4px);
      border-color: rgba(251, 191, 36, 0.5);
      box-shadow:
        0 8px 32px rgba(251, 191, 36, 0.12),
        0 0 0 1px rgba(251, 191, 36, 0.1);
    }

    .story-card__flipper {
      transition: none !important;
    }

    .story-card:hover .story-card__flipper {
      transform: none !important;
    }

    .story-card__back {
      display: none !important;
    }

    .story-card__front {
      border: none;
      background: transparent;
    }
  }
</style>
