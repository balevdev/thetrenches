---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="back-face">
  <div class="back-face__shine"></div>
  <div class="back-face__content">
    <div class="back-face__icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
    </div>
    <span class="back-face__label">Interactive Story</span>
    <h3 class="back-face__title" set:html={title} />
    <span class="back-face__cta">Read Story &rarr;</span>
  </div>
</div>

<style>
  /* ── Back face: dark theme (default) ── */
  .back-face {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1a1508 0%, #2d2006 100%);
    border: 1px solid rgba(251, 191, 36, 0.4);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  /* ── Corner accent lines ── */
  .back-face::before,
  .back-face::after {
    content: '';
    position: absolute;
    width: 40px;
    height: 40px;
    pointer-events: none;
  }

  .back-face::before {
    top: 16px;
    left: 16px;
    border-top: 1px solid rgba(251, 191, 36, 0.4);
    border-left: 1px solid rgba(251, 191, 36, 0.4);
  }

  .back-face::after {
    bottom: 16px;
    right: 16px;
    border-bottom: 1px solid rgba(251, 191, 36, 0.4);
    border-right: 1px solid rgba(251, 191, 36, 0.4);
  }

  /* ── Shine sweep overlay ── */
  .back-face__shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(251, 191, 36, 0.06) 45%,
      rgba(251, 191, 36, 0.12) 50%,
      rgba(251, 191, 36, 0.06) 55%,
      transparent 60%
    );
    pointer-events: none;
  }

  /* ── Content layout ── */
  .back-face__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .back-face__icon {
    color: #fbbf24;
    filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.5));
  }

  .back-face__label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(251, 191, 36, 0.7);
  }

  .back-face__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: #fbbf24;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .back-face__title :global(em) {
    font-style: italic;
  }

  .back-face__cta {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #1a1508;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    border-radius: 999px;
    box-shadow:
      0 2px 12px rgba(251, 191, 36, 0.3),
      0 0 20px rgba(251, 191, 36, 0.15);
  }

  /* ── Light theme overrides ── */
  :global([data-theme="light"]) .back-face {
    background: linear-gradient(135deg, #fef9e7 0%, #fdf2c5 100%);
    border-color: rgba(217, 119, 6, 0.35);
  }

  :global([data-theme="light"]) .back-face::before {
    border-top-color: rgba(217, 119, 6, 0.3);
    border-left-color: rgba(217, 119, 6, 0.3);
  }

  :global([data-theme="light"]) .back-face::after {
    border-bottom-color: rgba(217, 119, 6, 0.3);
    border-right-color: rgba(217, 119, 6, 0.3);
  }

  :global([data-theme="light"]) .back-face__shine {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(217, 119, 6, 0.06) 45%,
      rgba(217, 119, 6, 0.10) 50%,
      rgba(217, 119, 6, 0.06) 55%,
      transparent 60%
    );
  }

  :global([data-theme="light"]) .back-face__icon {
    color: #b45309;
    filter: drop-shadow(0 0 6px rgba(217, 119, 6, 0.3));
  }

  :global([data-theme="light"]) .back-face__label {
    color: rgba(146, 64, 14, 0.7);
  }

  :global([data-theme="light"]) .back-face__title {
    color: #92400e;
  }

  :global([data-theme="light"]) .back-face__cta {
    color: #fff;
    background: linear-gradient(135deg, #d97706, #b45309);
    box-shadow:
      0 2px 12px rgba(217, 119, 6, 0.25),
      0 0 20px rgba(217, 119, 6, 0.1);
  }
</style>
