---
interface Props {
  title: string;
  description: string;
  href: string;
  pubDate: Date;
  category: string;
  readTime: string;
  tags?: string[];
  heroImage?: string;
  backImage?: string;
  format?: 'article' | 'story' | 'paper';
}

const {
  title,
  description,
  href,
  pubDate,
  category,
  readTime,
  tags = [],
  heroImage,
  backImage,
  format = 'article',
} = Astro.props;

const isStory = format === 'story';
const isPaper = format === 'paper';
const hasBackFace = isPaper || (isStory && !!backImage);
const isSpecial = isStory || isPaper;
const badgeLabel = isPaper ? 'Brief' : 'Story';
const categoryLabel = isPaper ? 'Brief' : isStory ? 'Story' : category;
const backLabel = isPaper ? 'Research Brief' : 'Interactive Story';
const backCta = isPaper ? 'Read Brief \u2192' : 'Read Story \u2192';

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});

const isoDate = pubDate.toISOString();
---

<article class:list={['card', 'reveal', { 'card--story': isStory, 'card--paper': isPaper, 'card--has-back': hasBackFace }]}>
  <a href={href} class="card__link">
    <div class="card__front">
      <div class="card__image">
        {heroImage ? (
          <img src={heroImage} alt="" loading="lazy" decoding="async" />
        ) : isStory && backImage ? (
          <img src={backImage} alt="" class="card__cover" loading="lazy" decoding="async" />
        ) : (
          <div class="card__placeholder">
            {isPaper ? (
              <img src="/images/moonshot/moonshot.png" alt="" class="card__moonshot" loading="lazy" decoding="async" />
            ) : (
              <div class="card__placeholder-icon">
                {isStory ? (
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"></path>
                    <path d="M8 7h6"></path>
                    <path d="M8 11h8"></path>
                  </svg>
                )}
              </div>
            )}
          </div>
        )}
        {isSpecial && <span class="card__badge">{badgeLabel}</span>}
      </div>
      <div class="card__content">
        <div class="card__meta">
          <span class="card__category">{categoryLabel}</span>
          <span class="card__separator">&middot;</span>
          <time class="card__date" datetime={isoDate}>{formattedDate}</time>
        </div>
        <h3 class="card__title" set:html={title} />
        <p class="card__description">{description}</p>
        <div class="card__footer">
          <span class="card__read-time">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            {readTime}
          </span>
          {tags.length > 0 && (
            <div class="card__tags">
              {tags.slice(0, 2).map(tag => (
                <span class="badge">{tag}</span>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>

    {/* Back face — opt-in: papers always, stories only if backImage is set */}
    {hasBackFace && (
      <div class="card__back">
        <div class="card__back-shine"></div>
        <div class="card__back-content">
          <div class="card__back-icon">
            {isPaper ? (
              <img src="/images/moonshot/moonshot.png" alt="" class="card__back-moonshot" loading="lazy" decoding="async" />
            ) : (
              <img src={backImage} alt="" class="card__back-cover" loading="lazy" decoding="async" />
            )}
          </div>
          <span class="card__back-label">{backLabel}</span>
          <h3 class="card__back-title" set:html={title} />
          <span class="card__back-cta">{backCta}</span>
        </div>
      </div>
    )}
  </a>
</article>

<style>
  /* ══════════════════════════════════════════════
     Base card
     ══════════════════════════════════════════════ */
  .card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    overflow: hidden;
    transition: all var(--transition-smooth);
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--accent-primary);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  /* Front wrapper: invisible for regular cards, becomes a real box for story flip */
  .card__front {
    display: contents;
  }

  .card__image {
    aspect-ratio: 16 / 9;
    background-color: var(--bg-secondary);
    overflow: hidden;
    position: relative;
  }

  .card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth), opacity var(--transition-fast);
  }

  .card:hover .card__image img {
    transform: scale(1.05);
  }

  .card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      var(--accent-primary-muted) 0%,
      var(--bg-tertiary) 50%,
      var(--accent-cool-muted) 100%
    );
  }

  .card__placeholder-icon {
    color: var(--text-muted);
    opacity: 0.5;
    transition: all var(--transition-smooth);
  }

  .card:hover .card__placeholder-icon {
    transform: scale(1.1);
    opacity: 0.7;
  }

  .card__content {
    padding: var(--space-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .card__category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--accent-primary);
  }

  .card__separator {
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .card__date {
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    margin: 0 0 var(--space-3);
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .card:hover .card__title {
    color: var(--accent-primary);
  }

  .card__title :global(em) {
    font-style: italic;
    color: var(--accent-primary);
  }

  .card__description {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    flex: 1;
    margin: 0 0 var(--space-4);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }

  .card__read-time {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .card__read-time svg {
    opacity: 0.7;
  }

  .card__tags {
    display: flex;
    gap: var(--space-2);
  }

  .card__tags .badge {
    font-size: 0.65rem;
  }

  /* ══════════════════════════════════════════════
     Story variant — gold accent overrides
     ══════════════════════════════════════════════ */
  .card--story {
    border-color: rgba(251, 191, 36, 0.25);
    background-image: linear-gradient(
      160deg,
      var(--bg-card) 60%,
      rgba(251, 191, 36, 0.04) 100%
    );
  }

  .card--story:hover {
    border-color: rgba(251, 191, 36, 0.5);
    box-shadow:
      0 8px 32px rgba(251, 191, 36, 0.12),
      0 0 0 1px rgba(251, 191, 36, 0.1);
  }

  .card--story .card__placeholder {
    background: linear-gradient(
      135deg,
      rgba(251, 191, 36, 0.15) 0%,
      var(--bg-tertiary) 40%,
      rgba(251, 147, 60, 0.10) 70%,
      rgba(251, 191, 36, 0.08) 100%
    );
  }

  .card--story .card__placeholder-icon {
    color: #fbbf24;
    opacity: 0.6;
  }

  .card--story .card__category {
    color: #fbbf24;
  }

  .card--story:hover .card__title {
    color: #fbbf24;
  }

  .card--story .card__title :global(em) {
    color: #fbbf24;
  }

  .card--story .card__footer {
    border-top-color: rgba(251, 191, 36, 0.1);
  }

  .card__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1a1714;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  /* ══════════════════════════════════════════════
     Back face — hidden by default
     ══════════════════════════════════════════════ */
  .card__back {
    display: none;
  }

  /* ── Back face inner styles ── */
  .card__back-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(251, 191, 36, 0.06) 45%,
      rgba(251, 191, 36, 0.12) 50%,
      rgba(251, 191, 36, 0.06) 55%,
      transparent 60%
    );
    pointer-events: none;
  }

  .card__back-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }

  .card__back-icon {
    color: #fbbf24;
    filter: drop-shadow(0 0 8px rgba(251, 191, 36, 0.5));
  }

  .card__back-cover {
    width: 96px;
    height: 96px;
    border-radius: 14px;
    object-fit: cover;
    filter: drop-shadow(0 0 16px rgba(251, 191, 36, 0.3));
  }

  .card__back-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(251, 191, 36, 0.7);
  }

  .card__back-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-snug);
    color: #fbbf24;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__back-title :global(em) {
    font-style: italic;
  }

  .card__back-cta {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0.5rem 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: #1a1508;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    border-radius: 999px;
    box-shadow:
      0 2px 12px rgba(251, 191, 36, 0.3),
      0 0 20px rgba(251, 191, 36, 0.15);
  }

  /* ══════════════════════════════════════════════
     3D flip — desktop with hover only, opt-in via .card--has-back
     ══════════════════════════════════════════════ */
  @media (hover: hover) and (min-width: 769px) {
    .card--story.card--has-back {
      perspective: 1000px;
      overflow: visible;
      background: transparent;
      border: none;
      background-image: none;
    }

    .card--story.card--has-back:hover {
      transform: none;
      box-shadow: none;
      border-color: transparent;
    }

    .card--story.card--has-back .card__link {
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .card--story.card--has-back:hover .card__link {
      transform: rotateY(180deg);
    }

    /* Front becomes a real box for backface-visibility */
    .card--story.card--has-back .card__front {
      display: flex;
      flex-direction: column;
      height: 100%;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background-color: var(--bg-card);
      border: 1px solid rgba(251, 191, 36, 0.25);
      background-image: linear-gradient(
        160deg,
        var(--bg-card) 60%,
        rgba(251, 191, 36, 0.04) 100%
      );
    }

    :global([data-theme="light"]) .card--story.card--has-back .card__front {
      border-color: rgba(217, 119, 6, 0.2);
    }

    /* Back face — absolutely positioned, pre-rotated */
    .card--story.card--has-back .card__back {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      inset: 0;
      transform: rotateY(180deg);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: linear-gradient(135deg, #1a1508 0%, #2d2006 100%);
      border: 1px solid rgba(251, 191, 36, 0.4);
    }

    /* Corner accent lines on back face */
    .card--story.card--has-back .card__back::before,
    .card--story.card--has-back .card__back::after {
      content: '';
      position: absolute;
      width: 40px;
      height: 40px;
      pointer-events: none;
    }

    .card--story.card--has-back .card__back::before {
      top: 16px;
      left: 16px;
      border-top: 1px solid rgba(251, 191, 36, 0.4);
      border-left: 1px solid rgba(251, 191, 36, 0.4);
    }

    .card--story.card--has-back .card__back::after {
      bottom: 16px;
      right: 16px;
      border-bottom: 1px solid rgba(251, 191, 36, 0.4);
      border-right: 1px solid rgba(251, 191, 36, 0.4);
    }

    /* Disable front-face hover effects during flip */
    .card--story.card--has-back:hover .card__title {
      color: var(--text-primary);
    }

    .card--story.card--has-back:hover .card__image img {
      transform: none;
    }

    .card--story.card--has-back:hover .card__placeholder-icon {
      transform: none;
      opacity: 0.6;
    }
  }

  /* ══════════════════════════════════════════════
     Light theme — back face overrides
     ══════════════════════════════════════════════ */
  :global([data-theme="light"]) .card__back {
    background: linear-gradient(135deg, #fef9e7 0%, #fdf2c5 100%);
    border-color: rgba(217, 119, 6, 0.35);
  }

  :global([data-theme="light"]) .card__back::before {
    border-top-color: rgba(217, 119, 6, 0.3);
    border-left-color: rgba(217, 119, 6, 0.3);
  }

  :global([data-theme="light"]) .card__back::after {
    border-bottom-color: rgba(217, 119, 6, 0.3);
    border-right-color: rgba(217, 119, 6, 0.3);
  }

  :global([data-theme="light"]) .card__back-shine {
    background: linear-gradient(
      105deg,
      transparent 40%,
      rgba(217, 119, 6, 0.06) 45%,
      rgba(217, 119, 6, 0.10) 50%,
      rgba(217, 119, 6, 0.06) 55%,
      transparent 60%
    );
  }

  :global([data-theme="light"]) .card__back-icon {
    color: #b45309;
    filter: drop-shadow(0 0 6px rgba(217, 119, 6, 0.3));
  }

  :global([data-theme="light"]) .card__back-label {
    color: rgba(146, 64, 14, 0.7);
  }

  :global([data-theme="light"]) .card__back-title {
    color: #92400e;
  }

  :global([data-theme="light"]) .card__back-cta {
    color: #fff;
    background: linear-gradient(135deg, #d97706, #b45309);
    box-shadow:
      0 2px 12px rgba(217, 119, 6, 0.25),
      0 0 20px rgba(217, 119, 6, 0.1);
  }

  /* ══════════════════════════════════════════════
     Paper variant — cool-white monochrome (dark)
     ══════════════════════════════════════════════ */
  .card--paper {
    border-color: rgba(229, 227, 221, 0.18);
    background-image: linear-gradient(
      160deg,
      var(--bg-card) 60%,
      rgba(229, 227, 221, 0.03) 100%
    );
  }

  .card--paper:hover {
    border-color: rgba(229, 227, 221, 0.4);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.4),
      0 0 0 1px rgba(229, 227, 221, 0.08);
  }

  .card--paper .card__placeholder {
    background: linear-gradient(
      135deg,
      #14140f 0%,
      #1f1f1a 60%,
      #14140f 100%
    );
  }

  .card__moonshot {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    object-fit: cover;
    filter: drop-shadow(0 0 24px rgba(229, 227, 221, 0.18));
    transition: transform var(--transition-smooth);
  }

  .card--paper:hover .card__moonshot {
    transform: scale(1.06);
  }

  .card--paper .card__category {
    color: #e5e3dd;
    opacity: 0.75;
  }

  .card--paper:hover .card__title {
    color: #ffffff;
  }

  .card--paper .card__title :global(em) {
    color: #e5e3dd;
  }

  .card--paper .card__footer {
    border-top-color: rgba(229, 227, 221, 0.08);
  }

  .card--paper .card__badge {
    color: #14140f;
    background: linear-gradient(135deg, #f5f3ed, #cfcdc5);
  }

  /* ══════════════════════════════════════════════
     3D flip for paper — desktop hover
     ══════════════════════════════════════════════ */
  @media (hover: hover) and (min-width: 769px) {
    .card--paper {
      perspective: 1000px;
      overflow: visible;
      background: transparent;
      border: none;
      background-image: none;
    }

    .card--paper:hover {
      transform: none;
      box-shadow: none;
      border-color: transparent;
    }

    .card--paper .card__link {
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .card--paper:hover .card__link {
      transform: rotateY(180deg);
    }

    .card--paper .card__front {
      display: flex;
      flex-direction: column;
      height: 100%;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background-color: var(--bg-card);
      border: 1px solid rgba(229, 227, 221, 0.18);
      background-image: linear-gradient(
        160deg,
        var(--bg-card) 60%,
        rgba(229, 227, 221, 0.03) 100%
      );
    }

    :global([data-theme="light"]) .card--paper .card__front {
      border-color: rgba(26, 26, 26, 0.12);
      background-image: linear-gradient(
        160deg,
        var(--bg-card) 60%,
        rgba(26, 26, 26, 0.02) 100%
      );
    }

    .card--paper .card__back {
      display: flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      inset: 0;
      transform: rotateY(180deg);
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--radius-xl);
      overflow: hidden;
      background: linear-gradient(135deg, #0d0d0b 0%, #1c1c18 100%);
      border: 1px solid rgba(229, 227, 221, 0.3);
    }

    .card--paper .card__back::before,
    .card--paper .card__back::after {
      content: '';
      position: absolute;
      width: 40px;
      height: 40px;
      pointer-events: none;
    }

    .card--paper .card__back::before {
      top: 16px;
      left: 16px;
      border-top: 1px solid rgba(229, 227, 221, 0.35);
      border-left: 1px solid rgba(229, 227, 221, 0.35);
    }

    .card--paper .card__back::after {
      bottom: 16px;
      right: 16px;
      border-bottom: 1px solid rgba(229, 227, 221, 0.35);
      border-right: 1px solid rgba(229, 227, 221, 0.35);
    }

    .card--paper .card__back-shine {
      background: linear-gradient(
        105deg,
        transparent 40%,
        rgba(229, 227, 221, 0.04) 45%,
        rgba(229, 227, 221, 0.09) 50%,
        rgba(229, 227, 221, 0.04) 55%,
        transparent 60%
      );
    }

    .card--paper .card__back-icon {
      color: #e5e3dd;
      filter: drop-shadow(0 0 10px rgba(229, 227, 221, 0.25));
    }

    .card__back-moonshot {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      object-fit: cover;
    }

    .card--paper .card__back-label {
      color: rgba(229, 227, 221, 0.65);
    }

    .card--paper .card__back-title {
      color: #ffffff;
    }

    .card--paper .card__back-cta {
      color: #0d0d0b;
      background: linear-gradient(135deg, #f5f3ed, #cfcdc5);
      box-shadow:
        0 2px 12px rgba(0, 0, 0, 0.5),
        0 0 20px rgba(229, 227, 221, 0.12);
    }

    .card--paper:hover .card__title {
      color: var(--text-primary);
    }

    .card--paper:hover .card__moonshot {
      transform: none;
    }
  }

  /* ══════════════════════════════════════════════
     Paper — light theme overrides
     ══════════════════════════════════════════════ */
  :global([data-theme="light"]) .card--paper {
    border-color: rgba(26, 26, 26, 0.12);
  }

